# ============================================================================
# Fissue 环境变量示例 —— 复制为 .env 后按需修改
#
# 分工原则：
#   .env        → 只放「密钥 / 连接串 / 敏感项 / 环境相关项」
#   config.yaml → 放「业务规则」（仓库列表、阈值、策略、通知渠道等）
#
# 优先级（高 → 低）：
#   1. 进程环境变量   FISSUE_LLM_MODEL=x fissue eval
#   2. .env 文件      本文件
#   3. config.yaml    项目根目录
#   4. 内置默认值     见 config.example.yaml
#
# 所有变量都可省略；省略即用下一级的值。最少只需填 FISSUE_LLM_API_KEY。
# 详细说明见 docs/USAGE.md 第 3 节。
# ============================================================================


# ---------------------------------------------------------------------------
# TLS / 证书（可选，仅当遇到 CERTIFICATE_VERIFY_FAILED 时才需要）
#
# 报错 "unable to get local issuer certificate" 通常意味着环境里有 HTTPS 中间人：
#   企业安全网关（Zscaler / Netskope / 深信服…）或本机抓包工具
#   （Fiddler / Charles / SteamTools…）重签了证书，
#   它的根证书在**系统信任库**里（所以浏览器正常），但不在 certifi 里。
#
# Fissue 已默认安装 truststore 并自动改用系统信任库，多数情况无需配置。
# 若仍失败，按下面顺序排查。
# ---------------------------------------------------------------------------

# 方案 A：手动指定代理/企业的根证书（导出为 PEM 格式）
# FISSUE_CA_BUNDLE=E:/certs/corp-root-ca.pem

# 方案 B：临时关闭校验 —— 仅供本地排查，存在中间人攻击风险，切勿用于生产
# FISSUE_INSECURE_SKIP_VERIFY=1


# ---------------------------------------------------------------------------
# 元配置：指定配置文件位置（一般用不到）
# ---------------------------------------------------------------------------
# FISSUE_CONFIG=./config.yaml      # config.yaml 的路径
# FISSUE_ENV=./.env                # 本文件自身的路径（改用别的 env 文件时）
# FISSUE_CONFIG_LOCAL=./config.local.yaml
#   覆盖层的路径。WebUI 与 `fissue onboard` 改配置时**只写这一份**（默认与 config.yaml
#   同目录、名为 config.local.yaml），因此人手写的 config.yaml 与它里面的注释一字不动。
#   生效优先级：进程环境 > .env > 覆盖层 > config.yaml > 内置默认值。
# FISSUE_LOG_LEVEL=info            # debug | info | warning | error（等价于 fissue -v）


# ---------------------------------------------------------------------------
# 数据库（可选）
#
# 默认就是 SQLite（零依赖，文件落在 ./data/fissue.db，父目录会自动创建）：
#   FISSUE_DATABASE_URL=sqlite:///./data/fissue.db
# 生产 / 多机再换 PostgreSQL（SQLite 并发写会锁表），换之前要先建库：
#   createdb -U fissue fissue
#   FISSUE_DATABASE_URL=postgresql+psycopg://fissue:密码@localhost:5432/fissue
# ---------------------------------------------------------------------------
FISSUE_DATABASE_URL=sqlite:///./data/fissue.db


# ---------------------------------------------------------------------------
# AI 大模型（必须：FISSUE_LLM_API_KEY）
#
# 只有 FISSUE_LLM_API_KEY 是必需的；其余三项省略时读 config.yaml 的 llm 段。
# 换供应商只改 BASE_URL + MODEL：
#
#   DeepSeek    https://api.deepseek.com/v1                      deepseek-chat
#   OpenAI      https://api.openai.com/v1                        gpt-4o-mini
#   通义千问     https://dashscope.aliyuncs.com/compatible-mode/v1 qwen-plus
#   智谱 GLM     https://open.bigmodel.cn/api/paas/v4              glm-4-flash
#   Kimi        https://api.moonshot.cn/v1                       moonshot-v1-8k
#   本地 Ollama  http://localhost:11434/v1                        qwen2.5:14b
# ---------------------------------------------------------------------------
FISSUE_LLM_API_KEY=sk-your-key-here

# 以下三项可选（config.yaml 的 llm 段同样可配，此处填则覆盖之）
# FISSUE_LLM_BASE_URL=https://api.deepseek.com/v1
# FISSUE_LLM_MODEL=deepseek-chat
# 主模型调用失败时自动降级的备用模型（留空则不降级）
# FISSUE_LLM_FALLBACK_MODEL=deepseek-chat


# ---------------------------------------------------------------------------
# EdgeJev / Jev System One（可选：本地类型化决策模型，默认关闭）
#
# 本地起服务：edgejev serve --model ./jev-int8 --port 8009
# 它只提供 POST /v1/systemone，不能替代主模型；用于对可行性/难度/PR 质量做旁路打分。
# 其余参数（dimensions / relation / weight / min_confidence）在 config.yaml 的 edgejev 段配。
# ---------------------------------------------------------------------------
# FISSUE_EDGEJEV_ENABLED=true
# FISSUE_EDGEJEV_BASE_URL=http://127.0.0.1:8009
# FISSUE_EDGEJEV_API_KEY=local
# FISSUE_EDGEJEV_MODEL=jev-latest
# FISSUE_EDGEJEV_RELATION=second_opinion


# ---------------------------------------------------------------------------
# 代码托管平台 Token（可选，但强烈建议）
#
# 留空 = 匿名访问：只能读公开仓库，且限流很紧（GitHub 60 次/小时）。
# 配置后：限流放宽到 5000 次/小时，且自动修复（提 PR）必需写权限。
#
# 最小权限：
#   GitHub   classic token 勾 repo；或 fine-grained 勾 Contents+Issues+PR 读写
#   Gitee    「私人令牌」勾 projects / pull_requests / issues
#   AtomGit  「访问令牌」勾 read_repository / write_repository / issues / pull_requests
#   GitLab   「Access Token」勾 api（或 read_api + write_repository）
#
# 申请入口：
#   GitHub   https://github.com/settings/tokens
#   Gitee    https://gitee.com/profile/personal_access_tokens
#   AtomGit  https://atomgit.com/setting/token-classic
#   GitLab   https://gitlab.com/-/user_settings/personal_access_tokens
# ---------------------------------------------------------------------------
FISSUE_GITHUB_TOKEN=
FISSUE_GITEE_TOKEN=
FISSUE_ATOMGIT_TOKEN=
FISSUE_GITLAB_TOKEN=

# Gitee 第三方应用（OAuth，可选）：与个人访问令牌二选一。
#
# 只填 Client ID/Secret **不够**：它们是应用凭据，不能直接调 API，还要走一次
# 「用户授权 → 拿 code → 换 access_token」。脚本把这一步做完了：
#
#   python scripts/gitee_oauth.py --login     # 浏览器点同意，令牌自动写进本文件
#   python scripts/gitee_oauth.py --refresh   # access_token 约 1 天，过期后刷新
#
# 回调地址必须与 Gitee 应用设置里的「回调地址」完全一致（端口也要一致）。
# 拿到令牌后仍走 FISSUE_GITEE_TOKEN，适配器不需要区分令牌来源。
FISSUE_GITEE_CLIENT_ID=
FISSUE_GITEE_CLIENT_SECRET=
FISSUE_GITEE_REDIRECT_URI=http://127.0.0.1:8765/callback
# 可选：授权范围，留空用默认值 user_info projects pull_requests issues notes
FISSUE_GITEE_SCOPE=
# 由 scripts/gitee_oauth.py 自动写入（refresh_token 用于续期，不必手工填）
# FISSUE_GITEE_REFRESH_TOKEN=


# ---------------------------------------------------------------------------
# 入站 webhook（可选）
#
# 让平台把「新 Issue / 新 PR」直接推过来，省掉一个轮询间隔（默认抓取间隔 1 小时）。
# 还要在 config.yaml 里把 webhooks.enabled 打开；开启后**每个已启用平台都必须配**
# 对应密钥，否则拒绝启动（fail-closed——这个端点不带 bearer 鉴权，密钥就是身份证明）。
#
# ⚠️ 与上面的平台 Token 是**两回事，不要复用**：
#   * GitHub ：仓库 Webhook 里填的 Secret（用于 X-Hub-Signature-256 的 HMAC-SHA256）
#   * GitLab ：Webhook 的 “Secret token”（X-Gitlab-Token 逐字节比对）
#   * Gitee  ：Webhook 的密码（X-Gitee-Token 逐字节比对）
#   * AtomGit：同上（v5 同形状，未实测）
# ---------------------------------------------------------------------------
# FISSUE_WEBHOOK_ENABLED=false
# FISSUE_WEBHOOK_GITHUB_SECRET=
# FISSUE_WEBHOOK_GITEE_SECRET=
# FISSUE_WEBHOOK_ATOMGIT_SECRET=
# FISSUE_WEBHOOK_GITLAB_SECRET=


# ---------------------------------------------------------------------------
# 标签缓存（可选）
#
# 仓库标签列表在进程内按 TTL 复用。常驻服务长跑时若永不失效，平台侧新建的
# 标签会被一直判为「不存在」→ 反复创建 → 422 → 整条打标签失败。
# 等价于 config.yaml 的 platforms.label_cache_ttl_seconds；0 = 不缓存。
# ---------------------------------------------------------------------------
# FISSUE_LABEL_CACHE_TTL=600


# ---------------------------------------------------------------------------
# Web / API（可选）
#
# 鉴权模型（详见 docs/AUTH.md）：
#   * 会话登录（用户名 + 口令，可选 2FA）→ 浏览器用；
#   * API Key（Authorization: Bearer fissue_<prefix>_<secret>）→ 脚本 / CI 用；
#   * 回环与 web.trusted_networks 内的来源**免登录**。
#
# 口令、TOTP 密钥、API Key 哈希都存在数据库里（不是环境变量），配置项在 config.yaml
# 的 web.auth 段。首次部署时在浏览器打开 /login 用引导口令创建管理员即可。
#
# 这里保留一个兼容说明：老版本的 FISSUE_API_TOKEN 已不再是配置项，也不再有兼容垫片
# ——它不会被导入成 API Key，也不能当 Bearer 用（v1.3.0 移除）。若表里还留着
# prefix=legacy 的历史 Key，到「API Key」页吊销即可。
# ---------------------------------------------------------------------------
FISSUE_WEB_HOST=127.0.0.1
FISSUE_WEB_PORT=8000


# ---------------------------------------------------------------------------
# Docker 沙盒（可选，生产 Linux 建议配置）
#
# 沙盒执行默认走「进程内直调 Docker」（inline 模式），够用且简单。
# 生产环境建议改用转发组件：宿主机常驻一个受控进程，容器执行只经这条通道，
# 避免调用方持有 Docker 句柄。
#
#   fissue sandbox serve                     # 启动转发组件
#   FISSUE_SANDBOX_RUNNER_SOCKET=/run/fissue-runner.sock
#
# 注意：Windows 不支持 Unix domain socket，会自动回退 inline 模式。
# 该项等价于 config.yaml 的 sandbox.forwarder.socket。
# ---------------------------------------------------------------------------
# FISSUE_SANDBOX_RUNNER_SOCKET=/var/run/fissue-runner.sock
