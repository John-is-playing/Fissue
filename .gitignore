# 环境与密钥
.env
config.yaml
# 覆盖层：WebUI / `fissue onboard` 改配置时写的那一份（仓库列表、回环写入开关等）。
# 它与 config.yaml 一样是**本机产物**——不同机器该有不同的仓库列表与开关，
# 提交它等于把你这台机器的运行配置推给别人。默认位置在 config.yaml 旁边。
config.local.yaml

# 数据与产物
# 注意：这里用 ``data/*`` 而不是 ``data/``——被整目录排除时 git 根本不会
# 往里看，后面的 ``!`` 反排除就永远无效。用通配符排除「内容」才能单独放行
# 跑分基线（它是**要进版本库**的：冻结基线的意义就是日后能拿来逐项对比）。
data/*
!data/benchmarks/
*.log
.pytest_cache/
.ruff_cache/
.mypy_cache/
# pytest-cov 在仓库根落下的覆盖率数据（每次带 --cov 跑测都会重写）
.coverage
.coverage.*

# 本地数据库（SQLite 试用库，含抓取数据，不入版本库）
*.db
*.db-journal
# WAL 模式的两份附属文件：库在 WAL 下运行时必然生成（见 store/db.py 的
# `PRAGMA journal_mode=WAL`），服务只要跑着它们就在，不忽略会一直躺在 git status 里。
*.db-wal
*.db-shm
*.db.bak-*
*.sqlite
*.sqlite3

# 五套夹具的**仓库**都是独立 git 仓库（自带 .git），统一放在 demo/<kit>/repo/，
# 供推送到 GitHub 当测试夹具用。外层仓库只保留它们的"定义"
# （README / fixtures/ / scripts/），不嵌套整个仓库，否则 git 会把它当作
# embedded repository 处理，产生难以察觉的 submodule 陷阱。
#
# 五套必须**同一套规则**：此前 textkit 的仓库直接放在 demo/textkit/、定义文件
# 却散落在 demo/ 根（demo/README.md、demo/fixtures/、demo/scripts/），
# 于是它既不符合"定义在 demo/<kit>/ 下"的约定，也让忽略规则多出一条特例。
demo/textkit/repo/
demo/ratekit/repo/
demo/pipekit/repo/
demo/envkit/repo/
demo/lockkit/repo/

# demo 产物
demo/**/__pycache__/
demo/**/.pytest_cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# IDE
.idea/
.vscode/
.tmphelp
.atomcode

# 宣传物料（易拉宝 HTML / 构建脚本 / 导出 PNG / G-Star 动图）
# 它们是一次性的线下物料，不进版本库；但**必须**被忽略而不是留在未跟踪状态——
# `fissue bench capture` 用 `git status --porcelain` 判「工作区是否干净」，
# 未跟踪文件也会把基线标成「不可复现」（见 src/fissue/benchmark.py::git_state）。
banner/
src/atomgit/*.gif
